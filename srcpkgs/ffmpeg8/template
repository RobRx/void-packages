# Template file for 'ffmpeg8'
# Minimal, decode-only FFmpeg for Mozilla Firefox (external libavcodec loader).
pkgname=ffmpeg8
version=8.1.3
revision=1
hostmakedepends="pkg-config perl"
makedepends="$(vopt_if vaapi libva-devel)"
short_desc="Decoding, encoding and streaming software"
maintainer="Orphaned <orphan@voidlinux.org>"
license="LGPL-2.1-only"
homepage="https://ffmpeg.org"
changelog="https://raw.githubusercontent.com/FFmpeg/FFmpeg/master/Changelog"
distfiles="https://ffmpeg.org/releases/ffmpeg-${version}.tar.xz"
checksum=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3

build_options="vaapi"
build_options_default="vaapi"

case "$XBPS_TARGET_MACHINE" in
	i686*|x86_64*)
		hostmakedepends+=" nasm";;
esac

_apply_patch() {
	local args="$1" pname="$(basename $2)"

	if [ ! -f ".${pname}_done" ]; then
		patch -N $args -i $2
		touch .${pname}_done
	fi
}

do_configure() {
	# Fix gcc on x86_64-musl only
	if [ "$XBPS_TARGET_MACHINE" = "x86_64-musl" ]; then
		vsed -i configure -e "s;_cflags_speed='-O3';_cflags_speed='-O2';"
	fi

	if [ "$CROSS_BUILD" ]; then
		case "$XBPS_TARGET_MACHINE" in
			arm*) _arch="arm";;
			aarch64*) _arch="aarch64";;
			*) _arch="${XBPS_TARGET_MACHINE%%-musl}";;
		esac

		_args+=" --enable-cross-compile
			--sysroot=$XBPS_CROSS_BASE
			--cross-prefix=${XBPS_CROSS_TRIPLET}-
			--target-os=linux --arch=${_arch}"
	fi

	./configure --prefix=/usr \
		--disable-debug \
		--disable-iconv \
		--disable-stripping \
		--enable-shared \
		--disable-static \
		--disable-everything \
		--disable-programs \
		--disable-doc \
		--disable-autodetect \
		--disable-avdevice \
		--disable-avformat \
		--disable-avfilter \
		--disable-swscale \
		--disable-swresample \
		--disable-network \
		--disable-vulkan \
		$(vopt_enable vaapi) \
		--enable-decoder=h264,hevc,aac \
		$(vopt_if vaapi '--enable-hwaccel=h264_vaapi,hevc_vaapi,vp9_vaapi,av1_vaapi') \
		--enable-lto \
		${_args}
}

do_build() {
	make ${makejobs}
}

do_install() {
	make DESTDIR=${DESTDIR} install-libs
}
